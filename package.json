{
  "name": "sele",
  "version": "3.17.0",
  "description": "A lightweight desktop AI harness",
  "author": "ExposedCat",
  "license": "GPL-3.0-only",
  "desktopName": "com.chipichapa.sele.desktop",
  "main": "./out/main/index.js",
  "scripts": {
    "test": "node scripts/tests/run.mjs unit",
    "test:unit": "node scripts/tests/run.mjs unit",
    "test:integration": "node scripts/tests/run.mjs integration",
    "test:ui": "node scripts/tests/run.mjs ui",
    "test:runtime": "node scripts/tests/run.mjs runtime",
    "test:native": "node scripts/tests/run.mjs native",
    "test:e2e": "node scripts/e2e/run-e2e.cjs",
    "test:mobile-providers": "node scripts/e2e/run-mobile.cjs",
    "test:clean": "node scripts/tests/clean.mjs",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "preview:working-mark": "vite src/renderer --host 127.0.0.1 --port 5173",
    "build": "npm run typecheck && node --max-old-space-size=4096 node_modules/electron-vite/bin/electron-vite.js build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win nsis",
    "build:mac": "npm run build && electron-builder --mac dmg zip",
    "build:linux": "npm run build && electron-builder --linux flatpak",
    "package:linux-tarball": "bash scripts/package-linux-tarball.sh",
    "package:flatpak-repo": "bash scripts/package-flatpak-repository.sh",
    "benchmark:active-chat-switching": "SELE_BENCHMARK_ACTIVE_CHATS=1 SELE_BENCHMARK_CHAT_COUNT=400 node scripts/benchmarks/benchmark-workspace-navigation.cjs",
    "benchmark:streaming-composer": "SELE_BENCHMARK_ACTIVE_CHATS=1 SELE_BENCHMARK_TYPING=1 SELE_BENCHMARK_DEV=1 SELE_BENCHMARK_CHAT_COUNT=400 node scripts/benchmarks/benchmark-workspace-navigation.cjs",
    "benchmark:chat-navigation": "node scripts/benchmarks/benchmark-chat-navigation.cjs",
    "benchmark:chat-rendering": "node scripts/benchmarks/benchmark-chat-rendering.cjs",
    "benchmark:workspace-navigation": "node scripts/benchmarks/benchmark-workspace-navigation.cjs",
    "benchmark:workspace-interactions": "SELE_BENCHMARK_INTERACTIONS=1 SELE_BENCHMARK_CHAT_COUNT=2400 node scripts/benchmarks/benchmark-workspace-navigation.cjs",
    "benchmark:workspace-vite": "SELE_BENCHMARK_VITE=1 SELE_BENCHMARK_CHAT_COUNT=2400 node scripts/benchmarks/benchmark-workspace-navigation.cjs",
    "lint:fix": "biome lint --write .",
    "benchmark:render-caches": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/benchmarks/benchmark-render-caches.mjs",
    "benchmark:performance": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/benchmarks/benchmark-performance-hotpaths.mjs",
    "benchmark:opencode-streaming": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/benchmarks/benchmark-opencode-streaming.mjs",
    "benchmark:codex-revisions": "node scripts/benchmarks/benchmark-codex-revisions.mjs",
    "build:mobile:web": "node scripts/build-mobile-web.mjs",
    "sync:android": "npm run build:mobile:web && cap sync android",
    "build:android": "npm run sync:android && node scripts/build-android.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.263",
    "@capacitor/android": "8.6.0",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.6.0",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/merge": "^6.12.3",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@electron-toolkit/utils": "^4.0.0",
    "@floating-ui/core": "^1.7.3",
    "@floating-ui/dom": "^1.7.4",
    "@github/copilot-sdk": "^1.0.26",
    "@lezer/highlight": "^1.2.5",
    "@lydell/node-pty": "^1.1.0",
    "@modelcontextprotocol/ext-apps": "^2.0.3",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@opencode/client": "^2.2.0",
    "@react-symbols/icons": "^1.4.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "better-sqlite3": "^12.11.1",
    "bonjour-service": "1.4.4",
    "dompurify": "^3.4.12",
    "electron-updater": "^6.8.9",
    "kysely": "^0.29.3",
    "lucide": "^1.24.0",
    "lucide-animated": "^1.0.5",
    "lucide-react": "^1.24.0",
    "marked": "^18.0.7",
    "marked-footnote": "^1.4.0",
    "mermaid": "^11.17.2",
    "monaco-editor": "^0.56.0",
    "motion": "^13.4.4",
    "react-diff-view": "^3.3.3",
    "react-virtuoso": "^4.18.20",
    "refractor": "^5.0.0",
    "ws": "^8.22.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@biomejs/biome": "2.5.13",
    "@capacitor/cli": "8.6.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@opencode-ai/sdk": "^1.18.29",
    "@types/babel__core": "^7.20.5",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "^38.5.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "esbuild": "^0.25.12",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-refresh": "^0.18.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.6"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "electron-winstaller@5.4.0": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true,
    "electron@38.5.0": true
  },
  "volta": {
    "node": "22.23.1"
  }
}
