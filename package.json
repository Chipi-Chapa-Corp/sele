{
  "name": "sele",
  "version": "2.20.0",
  "description": "A lightweight desktop AI harness",
  "author": "ExposedCat",
  "license": "GPL-3.0-only",
  "desktopName": "com.chipichapa.sele.desktop",
  "main": "./out/main/index.js",
  "scripts": {
    "format": "biome format --write .",
    "lint": "biome lint .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test:chat-delivery": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test src/main/providers/registerProviderIpc.test.mjs src/main/providers/ProviderClientPool.test.mjs",
    "test:app-update": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test src/main/appUpdate.test.mjs src/main/macAppUpdate.test.mjs",
    "test:logging": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test src/main/diagnosticLog.test.mjs",
    "test:error-logging": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test src/errorLoggingAudit.test.mjs src/shared/expectedAbsence.test.mjs",
    "test:chat-scaling": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test src/main/providers/chatScaling.regression.test.mjs src/main/providers/chatAdapterScaling.test.mjs src/main/providers/workingPageScaling.test.mjs src/main/providers/chatWindow.test.mjs src/main/providers/ProviderNavigationHydration.test.mjs",
    "test:chat-state": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test src/renderer/src/chatModelPreferences.test.mjs src/renderer/src/chatConversationModel.test.mjs src/renderer/src/subagentLoading.test.mjs src/renderer/src/chatDetailWindow.test.mjs src/renderer/src/chatLoadRecovery.test.mjs src/renderer/src/chatViewportTransitions.test.mjs src/renderer/src/messageModelLabel.test.mjs src/renderer/src/chatMessageResources.test.mjs src/renderer/src/chatWriteAccess.test.mjs src/renderer/src/components/ChatConfigSectionHeader.test.mjs src/renderer/src/modelCatalogLoad.test.mjs src/renderer/src/renderableText.test.mjs src/renderer/src/workingStepDisclosure.test.mjs src/renderer/src/visualizationReference.test.mjs",
    "test:opencode": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test src/main/providers/opencode/*.test.mjs",
    "test:copilot": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test src/main/providers/copilot/*.test.mjs",
    "test:claude-history": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test src/main/providers/claude/ClaudeExpectedErrors.test.mjs src/main/providers/claude/ClaudeHistory.test.mjs src/main/providers/claude/ClaudeItemRenderers.test.mjs src/main/providers/claude/ClaudeTranscriptProjection.test.mjs src/main/providers/claude/ClaudeModels.test.mjs src/main/providers/claude/ClaudeModelDiscovery.test.mjs src/main/providers/claude/ClaudePermissions.test.mjs src/main/providers/claude/ClaudeStreaming.test.mjs src/main/providers/claude/ClaudeSendTransition.test.mjs src/main/providers/claude/partialJson.test.mjs src/main/providers/claude/ClaudeStateCache.test.mjs",
    "test:claude-accounts": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test src/main/providers/claude/ClaudeAccounts.test.mjs src/main/providers/claude/ClaudeAccountSwitch.test.mjs src/main/providers/claude/ClaudeAccountStorage.test.mjs src/main/providers/claude/ClaudeAccountFlow.test.mjs",
    "test:codex-history": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test src/main/providers/codex/CodexTranscriptProjection.test.mjs src/main/providers/codex/CodexGoalPrompts.test.mjs src/main/providers/codex/CodexGoals.test.mjs src/main/providers/transcriptProjection/recordChanges.test.mjs src/main/providers/codex/CodexCursorHistory.test.mjs src/main/providers/codex/CodexEditHistory.test.mjs src/main/providers/codex/CodexEditModel.test.mjs src/main/providers/codex/CodexItemRenderers.test.mjs src/main/providers/codex/CodexSteering.test.mjs src/main/providers/codex/CodexWriteAccess.test.mjs src/main/providers/codex/CodexLiveMerge.test.mjs src/main/providers/codex/CodexCommandStartAnchors.test.mjs src/main/providers/codex/CodexSubagents.test.mjs src/main/providers/codex/CodexBrowserPermissions.test.mjs src/main/providers/codex/CodexTitleModel.test.mjs src/main/providers/codex/CodexTranscriptMetadataIndex.test.mjs src/main/providers/codex/CodexTranscriptMetadataTransport.test.mjs src/main/providers/codex/CodexSubagentHistory.test.mjs src/main/providers/codex/CodexSubagentWindow.test.mjs src/main/providers/codex/CodexInitialLoad.test.mjs",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && node --max-old-space-size=4096 node_modules/electron-vite/bin/electron-vite.js build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win nsis",
    "build:mac": "npm run build && electron-builder --mac dmg zip",
    "build:linux": "npm run build && electron-builder --linux flatpak",
    "package:flatpak-repo": "bash scripts/package-flatpak-repository.sh",
    "test:browser-use": "node scripts/tests/test-browser-use.cjs",
    "test:chat-goal": "node scripts/tests/test-chat-goal.cjs",
    "test:codex-final-ui": "node scripts/tests/test-codex-final-response.cjs",
    "test:claude-discovery": "node --test src/main/providers/claude/ClaudeSessionDiscovery.test.mjs && node scripts/tests/test-claude-discovery.mjs",
    "test:ui-responsiveness": "node scripts/tests/test-ui-responsiveness.cjs",
    "test:input-focus": "node scripts/tests/test-input-focus.cjs",
    "test:visualization": "node scripts/tests/test-visualization.cjs",
    "lint:fix": "biome lint --write .",
    "benchmark:performance": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/benchmarks/benchmark-performance-hotpaths.mjs",
    "benchmark:codex-revisions": "node scripts/benchmarks/benchmark-codex-revisions.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.263",
    "@electron-toolkit/utils": "^4.0.0",
    "@floating-ui/core": "^1.7.3",
    "@floating-ui/dom": "^1.7.4",
    "@github/copilot-sdk": "^1.0.13",
    "@lydell/node-pty": "^1.1.0",
    "@opencode-ai/sdk": "^1.18.29",
    "@react-symbols/icons": "^1.4.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "better-sqlite3": "^12.11.1",
    "dompurify": "^3.4.12",
    "electron-updater": "^6.8.9",
    "kysely": "^0.29.3",
    "lucide": "^1.24.0",
    "lucide-animated": "^1.0.5",
    "lucide-react": "^1.24.0",
    "marked": "^18.0.7",
    "mermaid": "^11.17.2",
    "monaco-editor": "^0.56.0",
    "react-diff-view": "^3.3.3",
    "refractor": "^5.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "^38.5.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "typescript": "^5.9.3",
    "vite": "^7.2.6"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "electron-winstaller@5.4.0": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true,
    "electron@38.5.0": true
  },
  "volta": {
    "node": "22.23.1"
  }
}
