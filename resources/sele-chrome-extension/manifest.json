{
  "manifest_version": 3,
  "name": "Sele Browser Connection",
  "version": "1.2.2",
  "minimum_chrome_version": "125",
  "description": "Automatically connect Chrome or Opera website tabs to your local Sele conversations.",
  "permissions": ["debugger", "tabs", "downloads", "storage", "alarms"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Connect browser to Sele"
  }
}
