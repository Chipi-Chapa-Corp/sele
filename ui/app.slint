import { ResizablePane, ResizeEdge } from "components/resizable-pane.slint";

export component AppWindow inherits Window {
    title: "Sele";
    preferred-width: 1024px;
    preferred-height: 720px;
    min-width: 720px;
    min-height: 480px;
    background: #111318;

    chat-list := ResizablePane {
        x: 0px;
        height: root.height;
        pane-width: 260px;
        minimum-pane-width: 180px;
        maximum-pane-width: root.width - sidebar.width - 320px;
        available-pane-width: root.width - sidebar.minimum-pane-width - 320px;
        resize-edge: ResizeEdge.trailing;
        background: #171a20;

        Rectangle {
            background: #171a20;

            Text {
                x: 20px;
                y: 20px;
                text: "Chat list";
                color: #e7e9ee;
                font-size: 16px;
                font-weight: 600;
            }
        }
    }

    chat-view := Rectangle {
        x: chat-list.width;
        width: root.width - chat-list.width - sidebar.width;
        height: root.height;
        background: #111318;

        Text {
            x: 24px;
            y: 20px;
            text: "Chat view";
            color: #e7e9ee;
            font-size: 16px;
            font-weight: 600;
        }
    }

    sidebar := ResizablePane {
        x: root.width - self.width;
        height: root.height;
        pane-width: 300px;
        minimum-pane-width: 220px;
        maximum-pane-width: root.width - chat-list.width - 320px;
        available-pane-width: root.width - chat-list.width - 320px;
        resize-edge: ResizeEdge.leading;
        background: #171a20;

        Rectangle {
            background: #171a20;

            Text {
                x: 20px;
                y: 20px;
                text: "Sidebar";
                color: #e7e9ee;
                font-size: 16px;
                font-weight: 600;
            }
        }
    }
}
